# Comma-separated browser origins allowed to call this service. Never "*".
# A Vercel project serves production and preview from different origins, so this
# is a list: WEB_ORIGIN=https://zenith.vercel.app,https://zenith-preview.vercel.app
WEB_ORIGIN=http://localhost:3000

# OpenAI key for POST /v1/generate and POST /v1/derive. Without it the endpoints return 503 with
# code `generation_unconfigured` and the rest of the app is unaffected —
# drawing, editing and every deterministic tool work with this service down.
#
# Never commit the real value. `.env` is gitignored; this file is the template.
# In production put it in Secret Manager, not an env file on the instance.
OPENAI_API_KEY=
