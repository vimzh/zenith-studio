# Generate a unique value for every project with: bunx auth secret
AUTH_SECRET=

# Create a Google OAuth web client and register this local callback URL:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Base URL of apps/api. Defaults to http://localhost:3002 when unset.
# Set this to the deployed Cloud Run URL in the Vercel project.
NEXT_PUBLIC_API_URL=
